MONGODB_URI=mongodb://127.0.0.1:27017/ai-review-funnel
JWT_SECRET=replace-with-a-long-random-secret
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-5.4-mini
NEXT_PUBLIC_APP_URL=https://cooperfile.com
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
# Supabase's current dashboard may call the public auth key a publishable key.
# Either NEXT_PUBLIC_SUPABASE_ANON_KEY or NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY works.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
ADMIN_EMAILS=admin@example.com
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=replace-with-a-local-seed-password
SEED_CLIENT_EMAIL=client@example.com
SEED_CLIENT_PASSWORD=replace-with-a-local-seed-password
GOOGLE_APPS_SCRIPT_EMAIL_WEBHOOK_URL=https://script.google.com/macros/s/your-deployment-id/exec
GOOGLE_APPS_SCRIPT_EMAIL_WEBHOOK_SECRET=replace-with-a-long-random-secret
EMAIL_FROM_NAME=Cooperfile
CASHFREE_ENVIRONMENT=sandbox
CASHFREE_APP_ID=your-cashfree-app-id
CASHFREE_SECRET_KEY=your-cashfree-secret-key
CASHFREE_WEBHOOK_SECRET=your-cashfree-webhook-secret
