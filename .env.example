MONGODB_URI=mongodb://127.0.0.1:27017/ai-review-funnel
JWT_SECRET=replace-with-a-long-random-secret
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-5.4-mini
# Review AI provider: "openai" (default), "groq" (GroqCloud, free), or "grok" (xAI).
# Groq and Grok both use an OpenAI-compatible Chat Completions API.
REVIEW_AI_PROVIDER=openai
# Groq (GroqCloud) — free API key from console.groq.com (starts with gsk_).
# Model must support JSON-schema structured outputs.
GROQ_API_KEY=gsk_...
# Use a model that supports JSON-schema structured outputs (gpt-oss-20b does;
# llama-3.3-70b-versatile does NOT).
GROQ_MODEL=openai/gpt-oss-20b
# Optional override; defaults to https://api.groq.com/openai/v1
GROQ_BASE_URL=https://api.groq.com/openai/v1
# Grok (xAI) — key from console.x.ai (starts with xai-).
XAI_API_KEY=xai-...
XAI_MODEL=grok-4-fast
# Optional override; defaults to https://api.x.ai/v1
XAI_BASE_URL=https://api.x.ai/v1
NEXT_PUBLIC_APP_URL=https://cooperfile.com
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
# Supabase's current dashboard may call the public auth key a publishable key.
# Either NEXT_PUBLIC_SUPABASE_ANON_KEY or NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY works.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
ADMIN_EMAILS=admin@example.com
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=replace-with-a-local-seed-password
SEED_CLIENT_EMAIL=client@example.com
SEED_CLIENT_PASSWORD=replace-with-a-local-seed-password
GOOGLE_APPS_SCRIPT_EMAIL_WEBHOOK_URL=https://script.google.com/macros/s/your-deployment-id/exec
GOOGLE_APPS_SCRIPT_EMAIL_WEBHOOK_SECRET=replace-with-a-long-random-secret
EMAIL_FROM_NAME=Cooperfile
CASHFREE_ENVIRONMENT=sandbox
CASHFREE_APP_ID=your-cashfree-app-id
CASHFREE_SECRET_KEY=your-cashfree-secret-key
CASHFREE_WEBHOOK_SECRET=your-cashfree-webhook-secret
